generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  TRADESMAN
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum JobStatus {
  OPEN
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobUrgency {
  LOW
  MEDIUM
  HIGH
}

enum QuoteStatus {
  PENDING_PAYMENT
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum BookingStatus {
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id           String        @id @default(uuid())
  fullName     String
  firstName    String?
  lastName     String?
  email        String        @unique
  phoneNumber  String
  address      String
  region       String?
  city         String?
  zipCode      String?
  password     String
  role         Role          @default(USER)
  status       AccountStatus @default(ACTIVE)
  profileImage String?
  tokenBalance          Int           @default(0)
  passwordResetToken    String?
  passwordResetExpires  DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  tradesmanProfile       TradesmanProfile?
  warehouses             Warehouse[]
  postedJobs             Job[]             @relation("CustomerJobs")
  assignedJobs           Job[]             @relation("AssignedTradesman")
  quotes                 Quote[]
  customerBookings       Booking[]         @relation("CustomerBookings")
  tradesmanBookings      Booking[]         @relation("TradesmanBookings")
  reviewsWritten         Review[]          @relation("ReviewAuthor")
  reviewsReceived        Review[]          @relation("ReviewTarget")
  customerConversations  Conversation[]    @relation("ConversationCustomer")
  tradesmanConversations Conversation[]    @relation("ConversationTradesman")
  sentMessages           Message[]
  tokenPurchases         TokenPurchase[]
  tokenUsages            TokenUsage[]
  earnings               Earning[]

  @@index([role])
  @@index([status])
  @@index([passwordResetToken])
  @@map("users")
}

model TradesmanProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName         String?
  yearsExperience      Int      @default(0)
  specialties          String[]
  location             String?
  publicLiabilityCover Decimal? @db.Decimal(12, 2)
  averageRating        Decimal  @default(0) @db.Decimal(3, 2)
  totalReviews         Int      @default(0)
  jobsCompleted        Int      @default(0)
  responseTimeHours    Int?
  isVerified           Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("tradesman_profiles")
}

model Warehouse {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("warehouses")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs      Job[]

  @@map("categories")
}

model Job {
  id             String     @id @default(uuid())
  jobCode        String     @unique
  title          String
  description    String
  location       String
  city           String?
  budgetMin      Decimal    @db.Decimal(12, 2)
  budgetMax      Decimal    @db.Decimal(12, 2)
  urgency        JobUrgency @default(MEDIUM)
  status         JobStatus  @default(OPEN)
  preferredStart DateTime?
  completionBy   DateTime?
  specialNotes   String?
  scheduledAt    DateTime?
  leadPrice      Decimal?   @db.Decimal(10, 2)
  customerId     String
  customer       User       @relation("CustomerJobs", fields: [customerId], references: [id], onDelete: Cascade)
  tradesmanId    String?
  tradesman      User?      @relation("AssignedTradesman", fields: [tradesmanId], references: [id], onDelete: SetNull)
  categoryId     String
  category       Category   @relation(fields: [categoryId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  images        JobImage[]
  requirements  JobRequirement[]
  quotes        Quote[]
  booking       Booking?
  reviews       Review[]
  conversations Conversation[]
  tokenUsages   TokenUsage[]
  earnings      Earning[]

  @@index([status])
  @@index([categoryId])
  @@index([customerId])
  @@index([tradesmanId])
  @@index([location])
  @@index([createdAt])
  @@map("jobs")
}

model JobImage {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())

  @@index([jobId])
  @@map("job_images")
}

model JobRequirement {
  id    String @id @default(uuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  text  String

  @@index([jobId])
  @@map("job_requirements")
}

model Quote {
  id                String      @id @default(uuid())
  jobId             String
  job               Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tradesmanId       String
  tradesman         User        @relation(fields: [tradesmanId], references: [id], onDelete: Cascade)
  amount            Decimal     @db.Decimal(12, 2)
  estimatedDuration String
  startDate         DateTime
  materialsIncluded Boolean     @default(false)
  warranty          String?
  proposal          String
  status            QuoteStatus @default(PENDING_PAYMENT)
  stripeSessionId   String?     @unique
  tokensCharged     Int?
  amountPaid        Decimal?    @db.Decimal(10, 2)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  images  QuoteImage[]
  booking Booking?

  @@unique([jobId, tradesmanId])
  @@index([tradesmanId])
  @@index([status])
  @@map("quotes")
}

model QuoteImage {
  id        String   @id @default(uuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())

  @@index([quoteId])
  @@map("quote_images")
}

model Booking {
  id          String        @id @default(uuid())
  jobId       String        @unique
  job         Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  quoteId     String        @unique
  quote       Quote         @relation(fields: [quoteId], references: [id])
  customerId  String
  customer    User          @relation("CustomerBookings", fields: [customerId], references: [id])
  tradesmanId String
  tradesman   User          @relation("TradesmanBookings", fields: [tradesmanId], references: [id])
  price       Decimal       @db.Decimal(12, 2)
  scheduledAt DateTime?
  status      BookingStatus @default(ACCEPTED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([customerId])
  @@index([tradesmanId])
  @@index([status])
  @@map("bookings")
}

model Review {
  id          String    @id @default(uuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    User      @relation("ReviewAuthor", fields: [reviewerId], references: [id])
  tradesmanId String
  tradesman   User      @relation("ReviewTarget", fields: [tradesmanId], references: [id])
  rating      Int
  comment     String
  reply       String?
  repliedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([jobId, reviewerId])
  @@index([tradesmanId])
  @@map("reviews")
}

model Conversation {
  id            String   @id @default(uuid())
  customerId    String
  customer      User     @relation("ConversationCustomer", fields: [customerId], references: [id])
  tradesmanId   String
  tradesman     User     @relation("ConversationTradesman", fields: [tradesmanId], references: [id])
  jobId         String?
  job           Job?     @relation(fields: [jobId], references: [id])
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages Message[]

  @@index([customerId])
  @@index([tradesmanId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

model TokenPackage {
  id            String   @id @default(uuid())
  name          String
  price         Decimal  @db.Decimal(10, 2)
  tokenQuantity Int
  description   String
  badge         String?
  isActive      Boolean  @default(true)
  stripePriceId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchases TokenPurchase[]

  @@map("token_packages")
}

model TokenRule {
  id          String   @id @default(uuid())
  name        String
  minBudget   Decimal  @db.Decimal(12, 2)
  maxBudget   Decimal? @db.Decimal(12, 2)
  tokenCost   Int
  price       Decimal  @default(0) @db.Decimal(10, 2)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@map("token_rules")
}

model TokenPurchase {
  id              String         @id @default(uuid())
  tradesmanId     String
  tradesman       User           @relation(fields: [tradesmanId], references: [id])
  packageId       String
  package         TokenPackage   @relation(fields: [packageId], references: [id])
  tokens          Int
  amount          Decimal        @db.Decimal(10, 2)
  status          PurchaseStatus @default(PENDING)
  stripeSessionId String?        @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tradesmanId])
  @@index([status])
  @@map("token_purchases")
}

model TokenUsage {
  id          String   @id @default(uuid())
  tradesmanId String
  tradesman   User     @relation(fields: [tradesmanId], references: [id])
  jobId       String?
  job         Job?     @relation(fields: [jobId], references: [id])
  tokens      Int
  reason      String
  createdAt   DateTime @default(now())

  @@index([tradesmanId])
  @@map("token_usages")
}

model Earning {
  id          String   @id @default(uuid())
  tradesmanId String
  tradesman   User     @relation(fields: [tradesmanId], references: [id])
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id])
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@index([tradesmanId])
  @@index([createdAt])
  @@map("earnings")
}
